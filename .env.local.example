NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key
# 32+ bytes of random hex/base64. Generate with: openssl rand -hex 32
CHAT_STATE_SECRET=your-chat-state-hmac-secret

# Web push (Notificaciones). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
# Shared secret the Supabase pg_cron job must send to call /api/cron/reminders.
# See supabase/CRON_SETUP.md. Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret
